ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://aptum:aptum@localhost:5432/aptum

# Comma-separated browser origins allowed to call the API (the web app). Empty disables CORS.
CORS_ORIGINS=http://localhost:3000

# Firebase service account (same variables as aptum-api). Never commit real values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
# Also reject ID tokens issued before POST /users/me/sessions/revoke (one extra Firebase call per request). Set true in production.
FIREBASE_CHECK_REVOKED=false

OPENAI_API_KEY=
