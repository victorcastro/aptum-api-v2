ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://aptum:aptum@localhost:5432/aptum

# Firebase service account (same variables as aptum-api). Never commit real values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep on one line with literal \n: FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=""
# Also reject revoked sessions (one extra network call per request).
FIREBASE_CHECK_REVOKED=false

OPENAI_API_KEY=
